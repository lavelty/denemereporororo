{
  "name": "mc-bot-panel",
  "version": "1.0.0",
  "description": "Web control panel for multi-bot testing with Minecraft 1.8 - 26.3 support",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/setup-mcdata.js",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0",
    "minecraft-protocol": "git+https://github.com/suisarbre/node-minecraft-protocol.git#port-26.3",
    "mineflayer": "git+https://github.com/suisarbre/mineflayer.git#port-26.3",
    "prismarine-chunk": "git+https://github.com/suisarbre/prismarine-chunk.git#port-26.3",
    "prismarine-physics": "git+https://github.com/suisarbre/prismarine-physics.git#port-26.3",
    "socket.io": "^4.8.0"
  }
}
